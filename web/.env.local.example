# ============================================
# Smart Forecast - Web Frontend Environment
# Next.js application configuration
# Only NEXT_PUBLIC_* variables are exposed to browser
# ============================================

# ====== Backend API URL ======
# For local development (without Docker): http://localhost:8010/api/v1
# For Docker deployment: http://YOUR_SERVER_IP:8010/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# ====== MinIO Storage URL ======
# For local development (without Docker): http://localhost:9000
# For Docker deployment: http://YOUR_SERVER_IP:8012
NEXT_PUBLIC_MINIO_URL=http://localhost:8012

# ====== OpenWeatherMap API Key ======
# Used for weather map tile layers overlay (temperature, precipitation, clouds, wind, etc.)
# Get your API key from: https://openweathermap.org/api
NEXT_PUBLIC_OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
